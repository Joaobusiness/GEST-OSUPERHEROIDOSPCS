generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}
enum Role {
  ADMIN
  MEMBER
}
enum ServiceOrderStatus {
  OPEN
  DIAGNOSIS
  WAITING_APPROVAL
  WAITING_PARTS
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELED
}
enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
}
enum ItemKind {
  PART
  LABOR
  OTHER
}
enum UberMode {
  INCLUDED
  SEPARATE
  ABSORBED
}
enum TransactionType {
  INCOME
  EXPENSE
}
enum TransactionStatus {
  PENDING
  PAID
  CANCELED
}
enum TemplateKind {
  OPERATIONAL
  MARKETING
}
enum CampaignStatus {
  DRAFT
  ACTIVE
  DONE
}
enum BillingCycle {
  MONTHLY
  YEARLY
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  document      String?
  email         String
  phone         String?
  whatsapp      String?
  address       Json?
  logoUrl       String?
  timezone      String         @default("America/Sao_Paulo")
  status        TenantStatus   @default(ACTIVE)
  orderSeq      Int            @default(0)
  quoteSeq      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  members       TenantUser[]
  subscriptions Subscription[]
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean         @default(false)
  createdAt    DateTime        @default(now())
  memberships  TenantUser[]
  sessions     Session[]
  resets       PasswordReset[]
}

model TenantUser {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  role     Role   @default(MEMBER)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String   @db.Uuid
  tenantId  String?  @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id // sha256 of the emailed token
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  name             String                @db.VarChar(150)
  document         String?               @db.VarChar(20)
  phone            String                @db.VarChar(20) // E.164
  whatsapp         String?               @db.VarChar(20)
  email            String?               @db.VarChar(150)
  address          Json?
  notes            String?
  lastContactAt    DateTime?
  marketingConsent Boolean               @default(false) // never presumed
  marketingOptOut  Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  devices          CustomerDevice[]
  orders           ServiceOrder[]
  quotes           Quote[]
  interactions     CustomerInteraction[]

  @@index([tenantId])
  @@index([tenantId, lastContactAt])
  @@index([tenantId, name])
}

model CustomerDevice {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  customerId     String         @db.Uuid
  category       String
  brand          String?
  model          String?
  serialNumber   String?
  accessories    String?
  conditionNotes String?
  createdAt      DateTime       @default(now())
  customer       Customer       @relation(fields: [customerId], references: [id])
  orders         ServiceOrder[]

  @@index([tenantId, customerId])
}

model ServiceOrder {
  id                  String                  @id @default(uuid()) @db.Uuid
  tenantId            String                  @db.Uuid
  customerId          String                  @db.Uuid
  deviceId            String?                 @db.Uuid
  orderNumber         String
  description         String
  diagnosis           String?
  status              ServiceOrderStatus      @default(OPEN)
  estimatedDeliveryAt DateTime?
  completedAt         DateTime?
  deliveredAt         DateTime?
  warrantyDays        Int                     @default(0)
  totalAmount         Decimal                 @default(0) @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  customer            Customer                @relation(fields: [customerId], references: [id])
  device              CustomerDevice?         @relation(fields: [deviceId], references: [id])
  items               ServiceOrderItem[]
  history             ServiceOrderStatusLog[]
  quotes              Quote[]
  transactions        FinancialTransaction[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model ServiceOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  serviceOrderId String       @db.Uuid
  kind           ItemKind
  description    String
  quantity       Decimal      @default(1) @db.Decimal(10, 2)
  unitCost       Decimal      @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  order          ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceOrderId])
}

model ServiceOrderStatusLog {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  serviceOrderId String              @db.Uuid
  fromStatus     ServiceOrderStatus?
  toStatus       ServiceOrderStatus
  userId         String?             @db.Uuid
  note           String?
  createdAt      DateTime            @default(now())
  order          ServiceOrder        @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceOrderId])
}

model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  customerId     String       @db.Uuid
  serviceOrderId String?      @db.Uuid
  number         String
  revision       Int          @default(1)
  parentQuoteId  String?      @db.Uuid
  status         QuoteStatus  @default(DRAFT)
  uberMode       UberMode     @default(INCLUDED)
  uberCost       Decimal      @default(0) @db.Decimal(12, 2)
  uberMarkup     Boolean      @default(false)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  extraFee       Decimal      @default(0) @db.Decimal(12, 2)
  marginPct      Decimal      @default(0) @db.Decimal(5, 2)
  taxPct         Decimal      @default(0) @db.Decimal(5, 2)
  cardFeePct     Decimal      @default(0) @db.Decimal(5, 2)
  totalCost      Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal      @default(0) @db.Decimal(12, 2)
  executionDays  Int?
  validUntil     DateTime?
  paymentTerms   String?
  warranty       String?
  notes          String?
  sentAt         DateTime?
  decidedAt      DateTime?
  approvalMethod String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customer       Customer     @relation(fields: [customerId], references: [id])
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  items          QuoteItem[]

  @@unique([tenantId, number, revision])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  quoteId     String   @db.Uuid
  kind        ItemKind
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
}

model FinancialCategory {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @db.Uuid
  name         String
  type         TransactionType
  transactions FinancialTransaction[]

  @@unique([tenantId, name, type])
}

model FinancialTransaction {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  serviceOrderId String?              @db.Uuid
  quoteId        String?              @db.Uuid
  customerId     String?              @db.Uuid
  categoryId     String               @db.Uuid
  type           TransactionType
  status         TransactionStatus    @default(PENDING)
  description    String
  amount         Decimal              @db.Decimal(12, 2)
  dueDate        DateTime             @db.Date
  paidAt         DateTime?
  paymentMethod  String?
  // dedupe key such as quote:ID:uber so one cost is never booked twice
  allocationKey  String?
  createdAt      DateTime             @default(now())
  category       FinancialCategory    @relation(fields: [categoryId], references: [id])
  serviceOrder   ServiceOrder?        @relation(fields: [serviceOrderId], references: [id])
  payments       TransactionPayment[]

  @@unique([tenantId, allocationKey])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
}

model TransactionPayment {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  transactionId String               @db.Uuid
  amount        Decimal              @db.Decimal(12, 2)
  paidAt        DateTime             @default(now())
  method        String?
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
}

model PricingSettings {
  tenantId          String   @id @db.Uuid
  partMarginPct     Decimal  @default(40) @db.Decimal(5, 2)
  laborMarginPct    Decimal  @default(50) @db.Decimal(5, 2)
  minMarginPct      Decimal  @default(20) @db.Decimal(5, 2)
  cardFeePct        Decimal  @default(4) @db.Decimal(5, 2)
  taxPct            Decimal  @default(6) @db.Decimal(5, 2)
  defaultUberCost   Decimal  @default(0) @db.Decimal(12, 2)
  defaultUberMode   UberMode @default(INCLUDED)
  uberMarkup        Boolean  @default(false)
  otherCostsFixed   Decimal  @default(0) @db.Decimal(12, 2)
  inactiveDays      Int      @default(60)
  warrantyAlertDays Int      @default(15)
}

model PricingSimulation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  label     String?
  input     Json
  result    Json
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model CommunicationTemplate {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  name      String
  kind      TemplateKind @default(OPERATIONAL)
  body      String
  createdAt DateTime     @default(now())

  @@index([tenantId])
}

model Campaign {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  name       String
  segment    String
  templateId String?           @db.Uuid
  status     CampaignStatus    @default(DRAFT)
  createdAt  DateTime          @default(now())
  contacts   CampaignContact[]

  @@index([tenantId])
}

model CampaignContact {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  campaignId  String    @db.Uuid
  customerId  String    @db.Uuid
  contactedAt DateTime?
  result      String?
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([tenantId])
}

model CustomerInteraction {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  customerId String       @db.Uuid
  channel    String       @default("whatsapp")
  kind       TemplateKind @default(OPERATIONAL)
  result     String?
  note       String?
  userId     String?      @db.Uuid
  createdAt  DateTime     @default(now())
  customer   Customer     @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model SubscriptionPlan {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  price         Decimal        @db.Decimal(12, 2)
  billingCycle  BillingCycle   @default(MONTHLY)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  planId    String             @db.Uuid
  status    SubscriptionStatus @default(TRIAL)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
}
